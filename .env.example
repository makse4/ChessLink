# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token

# Optional: register slash commands to one server instantly (global commands can take up to an hour)
GUILD_ID=

# SQLite database file
DATABASE_PATH=chesslink.db

# Public base URL that Lichess redirects to after login. Must match what users reach.
# Lichess allows http://localhost for development; use https in production.
PUBLIC_URL=http://localhost:8080

# Address the OAuth callback server listens on
OAUTH_HOST=0.0.0.0
OAUTH_PORT=8080

# Lichess OAuth client id (any unique string; no registration needed)
LICHESS_CLIENT_ID=chesslink-bot

# Sent with requests to Lichess and chess.com. Put a contact address here.
USER_AGENT=ChessLinkBot/1.0 (contact: you@example.com)

# Rating role configuration (see rating_roles.example.json). Roles are disabled if the file is missing.
RATING_ROLES_PATH=rating_roles.json

# How often to re-check every linked user's rating, in minutes
RATING_REFRESH_MINUTES=60
